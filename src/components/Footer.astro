---
import { getLang, useTranslations } from '../i18n';
import { loadSettings } from '../lib/settings';
import SubscribeForm from './SubscribeForm.astro';
import Reveal from './Reveal.astro';
import { limitsFor } from '../lib/plans';

const settings = await loadSettings(Astro.locals.publication.id);
const clientName = settings.clientName;
const today = new Date();
const showWatermark = limitsFor(Astro.locals.publication).watermark || settings.widgetHideWatermark !== '1';

const lang = getLang(Astro.request);
const t = useTranslations(lang);
---

<section class="envelope pocket" aria-label={t('subscribe.heading')}>
	<span class="envelope-mark deboss reveal" aria-hidden="true">{clientName}</span>
	<div class="envelope-slot lift reveal from-pocket" style="--i: 1">
		<SubscribeForm lang={lang} />
	</div>
	<footer class="deboss">
		<span class="micro">&copy; {today.getFullYear()} {clientName}</span>
		<span class="sep" aria-hidden="true">✦</span>
		<span class="micro">{t('footer.rights')}</span>
		<span class="sep" aria-hidden="true">✦</span>
		<a class="micro foot-link" href="/report">{t('footer.report')}</a>
		{showWatermark && (<><span class="sep" aria-hidden="true">✦</span><a class="micro foot-link" href="https://edgeletter.blog/?utm_source=footer">{t('footer.made')}</a></>)}
	</footer>
</section>
<Reveal />

<style>
	.envelope {
		margin-top: 4rem;
		padding: clamp(7.5rem, 15vw, 11rem) 1.25rem 0;
		overflow: hidden;
	}
	/* Large tone-on-tone debossed mark behind the letter */
	.envelope-mark {
		position: absolute;
		top: 2.75rem;
		left: 0;
		right: 0;
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		font-family: var(--font-display-stack);
		font-weight: var(--display-weight);
		word-spacing: var(--display-words);
		font-size: clamp(3.25rem, 10vw, 7.5rem);
		line-height: 1;
		letter-spacing: var(--display-tracking);
		pointer-events: none;
		user-select: none;
	}
	.envelope-slot {
		position: relative;
		z-index: 1;
		max-width: 560px;
		margin: 0 auto;
	}
	footer {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.4rem 0.9rem;
		padding: 3.5rem 1rem 3rem;
		text-align: center;
	}
	.sep { font-size: 0.7rem; }
	.foot-link { color: inherit; text-decoration: none; }
	.foot-link:hover { text-decoration: underline; color: var(--on-accent); }
</style>
