---
import { and, eq, gt, isNull } from 'drizzle-orm';
import AppLayout from '../../layouts/AppLayout.astro';
import { getDbInstance, loginTokens, memberships, users } from '../../db';
import { EMAIL_RE, issueLoginToken, normalizeEmail } from '../../lib/auth';
import { sendInvite } from '../../lib/auth-email';
import { allow } from '../../lib/ratelimit';
import { getLang } from '../../i18n';
import { studio } from '../../i18n/studio';


const { user, publication } = Astro.locals as Required<App.Locals>;
const t = studio(getLang(Astro.request));
const db = getDbInstance();
let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = form.get('action');
	if (action === 'invite') {
		const email = normalizeEmail(String(form.get('email') ?? ''));
		const role = form.get('role') === 'owner' ? 'owner' : 'editor';
		if (!EMAIL_RE.test(email)) error = t('signin.errEmail');
		else if (!(await allow(`invite:${publication.id}`))) error = t('team.errInviteRate');
		else {
			const token = await issueLoginToken({ email, purpose: 'invite', publicationId: publication.id, role });
			try {
				await sendInvite(email, `${Astro.url.origin}/auth/verify?token=${token}`, publication.name, user.name ?? user.email, getLang(Astro.request));
				notice = t('team.sent', { email });
			} catch {
				error = t('team.errSend');
			}
		}
	} else if (action === 'remove') {
		const target = String(form.get('user') ?? '');
		const owners = await db
			.select({ id: memberships.userId })
			.from(memberships)
			.where(and(eq(memberships.publicationId, publication.id), eq(memberships.role, 'owner')));
		if (owners.length === 1 && owners[0]!.id === target) error = t('team.lastOwner');
		else {
			await db.delete(memberships).where(and(eq(memberships.publicationId, publication.id), eq(memberships.userId, target)));
			notice = t('team.removed');
		}
	}
}

const team = await db
	.select({ id: users.id, email: users.email, name: users.name, role: memberships.role })
	.from(memberships)
	.innerJoin(users, eq(users.id, memberships.userId))
	.where(eq(memberships.publicationId, publication.id));
const pending = await db
	.select({ email: loginTokens.email, role: loginTokens.role, expiresAt: loginTokens.expiresAt })
	.from(loginTokens)
	.where(
		and(
			eq(loginTokens.publicationId, publication.id),
			eq(loginTokens.purpose, 'invite'),
			isNull(loginTokens.usedAt),
			gt(loginTokens.expiresAt, new Date()),
		),
	);
---

<AppLayout title={t('nav.team')} current="members">
	<div class="card app-card">
		<header class="page-head">
			<span class="eyebrow">{t('team.eyebrow')}</span>
			<h1>{t('nav.team')}</h1>
			<p class="sub">{t('team.lead')}</p>
		</header>
		{notice && <div class="alert ok">{notice}</div>}
		{error && <div class="alert err">{error}</div>}

		<h2>{t('team.members')}</h2>
		<table>
			<thead><tr><th>{t('team.person')}</th><th>{t('team.role')}</th><th></th></tr></thead>
			<tbody>
				{team.map((m) => (
					<tr>
						<td>{m.name ? <>{m.name} <span class="muted">{m.email}</span></> : m.email}{m.id === user.id && <span class="muted"> {t('team.you')}</span>}</td>
						<td><span class="badge">{t(m.role === 'owner' ? 'role.owner' : 'role.editor')}</span></td>
						<td style="text-align:right">
							<form method="post" class="inline-form">
								<input type="hidden" name="action" value="remove" />
								<input type="hidden" name="user" value={m.id} />
								<button type="submit" class="btn-link" style="background:none;color:var(--accent);border:0;padding:0;letter-spacing:0;text-transform:none;font-size:0.9rem">{t('common.remove')}</button>
							</form>
						</td>
					</tr>
				))}
			</tbody>
		</table>
		{pending.length > 0 && (
			<p class="muted" style="margin-top:1rem">{t('team.pending')} {pending.map((p) => `${p.email} (${t(p.role === 'owner' ? 'role.owner' : 'role.editor')})`).join(', ')}</p>
		)}

		<h2>{t('team.invite')}</h2>
		<form method="post" class="row">
			<input type="hidden" name="action" value="invite" />
			<div class="field">
				<label for="email">{t('team.email')}</label>
				<input id="email" name="email" type="email" required placeholder={t('team.emailPh')} />
			</div>
			<div class="field" style="flex:0 0 160px;min-width:140px">
				<label for="role">{t('team.role')}</label>
				<select id="role" name="role"><option value="editor">{t('team.editor')}</option><option value="owner">{t('team.owner')}</option></select>
			</div>
			<button type="submit">{t('team.send')}</button>
		</form>
	</div>
</AppLayout>
