---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { getLang, useTranslations } from '../../i18n';
import { listPosts } from '../../lib/post-lists';
import { loadSettings } from '../../lib/settings';

const lang = getLang(Astro.request);
const t = useTranslations(lang);

const settings = await loadSettings(Astro.locals.publication.id);
const clientName = settings.clientName;

const all = await listPosts(Astro.locals.publication.id, lang);
const [featured, ...rest] = all;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${t('blog.title')} — ${clientName}`} description={`All posts from ${clientName}.`} />
	</head>
	<body>
		<Header />
		<main class="blog-main">
			<header class="page-head">
				<span class="eyebrow rise" style="--i: 0">{t('blog.eyebrow')}</span>
				<h1 class="rise" style="--i: 1">{t('blog.title')}</h1>
				<div class="ornament rise" style="--i: 2" aria-hidden="true">✦</div>
			</header>
			{!featured ? (
				<p class="empty">{t('blog.empty')}</p>
			) : (
				<>
					<PostCard post={featured} lang={lang} variant="feature" badge={t('blog.latest')} />
					{rest.length > 0 && (
						<ul class="grid">
							{rest.map((p, i) => (
								<li><PostCard post={p} lang={lang} i={(i % 3) + 1} /></li>
							))}
						</ul>
					)}
				</>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-main { width: 1080px; }
	.page-head { text-align: center; margin-bottom: 3rem; }
	.page-head h1 { font-size: clamp(3rem, 8vw, 5rem); margin: 0; }
	.empty { text-align: center; font-style: italic; color: var(--muted); }
	.grid {
		list-style: none;
		padding: 0;
		margin: 1.75rem 0 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.75rem;
	}
	.grid li { display: flex; }
	.grid li > :global(a) { flex: 1; }
</style>
