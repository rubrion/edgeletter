---
import { desc, eq } from 'drizzle-orm';
import { getDbInstance, subscribers } from '../../db';
import { loadSettings } from '../../lib/settings';
import AdminAppbar from '../../components/AdminAppbar.astro';
import AdminHead from '../../components/AdminHead.astro';
import { getLang } from '../../i18n';
import { studio } from '../../i18n/studio';


const settings = await loadSettings(Astro.locals.publication.id);
const themeColor = settings.themePrimaryColor;

const db = getDbInstance();
const rows = await db
  .select()
  .from(subscribers)
  .where(eq(subscribers.publicationId, Astro.locals.publication.id))
  .orderBy(desc(subscribers.createdAt));

const saved = Astro.url.searchParams.get('saved') === '1';
const error = Astro.url.searchParams.get('error');
const lang = getLang(Astro.request);
const t = studio(lang);
const imported = Astro.url.searchParams.get('imported');
const skippedN = Astro.url.searchParams.get('skipped');
const capped = Astro.url.searchParams.get('capped') === '1';

const fmt = (d: Date | number): string => {
  const date = typeof d === 'number' ? new Date(d) : d;
  return date.toLocaleDateString(lang === 'pt-BR' ? 'pt-BR' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' });
};
---
<!doctype html>
<html lang={lang}>
<head>
  <AdminHead title={`Subscribers — ${settings.clientName}`} />
  <style is:global>
    .add-row { display: flex; gap: 0.6rem; }
    .add-row input[type="email"] { flex: 1; }
    td.email { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.85rem; color: var(--ink); }
    td.actions { text-align: right; white-space: nowrap; }
    td.actions form { display: inline; margin-left: 0.9rem; }
    td.actions button {
      padding: 0.3rem 0; background: none; border: none; border-bottom: 1px solid transparent;
      color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: 0.14em;
      text-transform: uppercase; cursor: pointer; transition: color 0.2s, border-color 0.2s;
    }
    td.actions button:hover { color: var(--accent); border-bottom-color: var(--accent); }
    td.actions button.danger:hover { color: #9C2F14; border-bottom-color: #9C2F14; }
    .badge.active { color: #4F6B3A; }
    .badge.unsubscribed { color: var(--muted); }
    .badge.pending { color: var(--accent); }
    .table-scroll { overflow-x: auto; }
    .import-form { display: grid; gap: 0.75rem; }
    .consent { display: flex; gap: 0.5rem; align-items: center; font-size: 0.95rem; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--text); margin: 0; }
    .io-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
    .secondary-btn { background: transparent !important; color: var(--ink) !important; }
    .secondary-btn:hover { background: var(--ink) !important; color: var(--card) !important; }
  </style>
</head>
<body style={`--theme: ${themeColor}`}>
  <AdminAppbar current="subscribers" />
  <div class="wrap">
    <div class="card">
      <header class="page-head">
        <span class="eyebrow">{t('sub.eyebrow')}</span>
        <h1>{t('nav.subscribers')}</h1>
        <p class="sub">{t('sub.lead')}</p>
      </header>

      {saved && <div class="alert ok">{t('common.saved')}</div>}
      {error && <div class="alert err">{error}</div>}

      <h2>{t('sub.add')}</h2>
      <form method="POST" action="/api/admin/subscribers" class="add-row">
        <input type="email" name="email" placeholder="someone@example.com" required autocomplete="off" />
        <button type="submit">{t('sub.addBtn')}</button>
      </form>

      <h2>{t('sub.io')}</h2>
      {imported !== null && (
        <div class:list={['alert', capped ? 'err' : 'ok']}>
          {t('sub.imported', { n: imported, s: skippedN ?? '0' })}{capped && t('sub.capped')}
        </div>
      )}
      <form method="POST" action="/api/admin/subscribers/import" enctype="multipart/form-data" class="import-form">
        <input type="file" name="file" accept=".csv,text/csv" required />
        <label class="consent"><input type="checkbox" name="consent" value="1" required /> {t('sub.consent')}</label>
        <div class="io-actions">
          <button type="submit">{t('sub.importCsv')}</button>
          <a class="button secondary-btn" href="/api/admin/subscribers/export">{t('sub.exportCsv')}</a>
        </div>
      </form>

      <h2>{t('sub.all', { n: rows.length })}</h2>
      {rows.length === 0 ? (
        <div class="empty">{t('sub.none')}</div>
      ) : (
        <div class="table-scroll"><table>
          <thead>
            <tr>
              <th>{t('sub.email')}</th>
              <th>{t('sub.status')}</th>
              <th>{t('sub.language')}</th>
              <th>{t('sub.joined')}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((s) => {
              const canUnsubscribe = s.status !== 'unsubscribed';
              return (
                <tr>
                  <td class="email">{s.email}</td>
                  <td><span class={`badge ${s.status}`}>{t(`sub.st.${s.status}` as 'sub.st.active')}</span></td>
                  <td>{s.lang.toUpperCase()}</td>
                  <td>{fmt(s.createdAt)}</td>
                  <td class="actions">
                    {canUnsubscribe && (
                      <form method="POST" action={`/api/admin/subscribers/${s.id}/status`}>
                        <input type="hidden" name="status" value="unsubscribed" />
                        <button type="submit">{t('sub.unsubscribe')}</button>
                      </form>
                    )}
                    <form method="POST" action={`/api/admin/subscribers/${s.id}/delete`} class="delete-form">
                      <button type="submit" class="danger">{t('sub.delete')}</button>
                    </form>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table></div>
      )}
    </div>
  </div>

  <script define:vars={{ confirmText: t('sub.confirmDelete') }}>
    document.querySelectorAll('form.delete-form').forEach((form) => {
      form.addEventListener('submit', (e) => {
        if (!confirm(confirmText)) {
          e.preventDefault();
        }
      });
    });
  </script>
</body>
</html>
