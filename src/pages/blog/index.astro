---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { getLang, useTranslations } from '../../i18n';
import { loadSettings } from '../../lib/settings';
import { getDbInstance, posts } from '../../db';
import { desc, eq } from 'drizzle-orm';

const lang = getLang(Astro.request);
const t = useTranslations(lang);

const settings = await loadSettings();
const clientName = settings.clientName;

const db = getDbInstance();
const all = await db
	.select({ slug: posts.slug, title: posts.title, publishedAt: posts.publishedAt })
	.from(posts)
	.where(eq(posts.isPublished, true))
	.orderBy(desc(posts.publishedAt));
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${t('blog.title')} — ${clientName}`} description={`All posts from ${clientName}.`} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<span class="eyebrow rise" style="--i: 0">{t('blog.eyebrow')}</span>
				<h1 class="rise" style="--i: 1">{t('blog.title')}</h1>
				<div class="ornament rise" style="--i: 2" aria-hidden="true">✦</div>
			</header>
			{all.length === 0 ? (
				<p class="empty">{t('blog.empty')}</p>
			) : (
				<ol class="post-list">
					{all.map((p, i) => (
						<li>
							<a href={`/blog/${p.slug}`} class="card lift reveal" style={`--i: ${i % 3}`}>
								<span class="micro num">{String(all.length - i).padStart(2, '0')}</span>
								<span class="title">{p.title}</span>
								{p.publishedAt && (
									<span class="micro date"><FormattedDate date={p.publishedAt} lang={lang} /></span>
								)}
							</a>
						</li>
					))}
				</ol>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head { text-align: center; margin-bottom: 2.5rem; }
	.page-head h1 { font-size: clamp(3rem, 8vw, 5rem); margin: 0; }
	.empty { text-align: center; font-style: italic; color: var(--muted); }
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.post-list a {
		display: grid;
		grid-template-columns: 3rem 1fr auto;
		align-items: baseline;
		gap: 1.25rem;
		padding: 1.4rem 1.75rem;
		text-decoration: none;
		color: var(--text);
	}
	.post-list .num { color: var(--accent); }
	.post-list .title {
		font-family: var(--font-display-stack);
		font-weight: var(--display-weight);
		word-spacing: var(--display-words);
		font-size: 1.6rem;
		line-height: 1.1;
		letter-spacing: var(--display-tracking);
		color: var(--ink);
		transition: color 0.2s;
	}
	.post-list a:hover .title { color: var(--accent); }
	.post-list .date { color: var(--muted); white-space: nowrap; }
	@media (max-width: 600px) {
		.post-list a { grid-template-columns: 1fr; gap: 0.4rem; padding: 1.2rem 1.25rem; }
	}
</style>
