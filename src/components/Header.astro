---
import { getLang, useTranslations } from '../i18n';
import { loadSettings } from '../lib/settings';
import HeaderLink from './HeaderLink.astro';
import LogoMark from './LogoMark.astro';

const settings = await loadSettings();
const clientName = settings.clientName;
const logoUrl = settings.clientLogoUrl || null;

const lang = getLang(Astro.request);
const t = useTranslations(lang);
const nextLang = lang === 'en' ? 'pt-BR' : 'en';
const langLabel = lang === 'en' ? 'PT' : 'EN';
---

<header>
	<nav>
		<a href="/" class="wordmark">
			{logoUrl ? (
				<img src={logoUrl} alt={clientName} class="logo" />
			) : (
				<>
					<LogoMark size={30} class="mark" />
					<span>{clientName}</span>
				</>
			)}
		</a>
		<div class="internal-links">
			<HeaderLink href="/">{t('nav.home')}</HeaderLink>
			<HeaderLink href="/blog">{t('nav.blog')}</HeaderLink>
			<HeaderLink href="/about">{t('nav.about')}</HeaderLink>
		</div>
		<div class="controls">
			<button id="theme-toggle" class="ctrl-btn micro" aria-label={t('nav.toggleDark')} title={t('nav.toggleDark')}>
				<span class="icon-sun" aria-hidden="true">☀</span>
				<span class="icon-moon" aria-hidden="true">☽</span>
			</button>
			<button
				id="lang-toggle"
				class="ctrl-btn micro bracket"
				aria-label={`Switch to ${nextLang}`}
				data-next-lang={nextLang}
			>{langLabel}</button>
		</div>
	</nav>
</header>

<script define:vars={{ toDark: t('nav.toDark'), toLight: t('nav.toLight') }}>
  // Dark mode toggle
  const themeBtn = document.getElementById('theme-toggle');
  function syncTheme() {
    const dark = document.documentElement.dataset.theme === 'dark';
    themeBtn.setAttribute('aria-label', dark ? toLight : toDark);
  }
  themeBtn.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('edgeletter-theme', next);
    syncTheme();
  });
  syncTheme();

  // Language toggle
  const langBtn = document.getElementById('lang-toggle');
  langBtn.addEventListener('click', () => {
    const next = langBtn.dataset.nextLang;
    document.cookie = `lang=${next}; path=/; max-age=31536000; SameSite=Lax`;
    window.location.reload();
  });
</script>

<style>
	header {
		position: relative;
		z-index: 10;
		margin: 0;
		padding: 0 1.5em;
		background: var(--bg-header);
		border-bottom: var(--hairline);
		box-shadow: var(--shadow-paper);
		transition: background-color 0.2s;
	}
	nav {
		max-width: 1080px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		min-height: 4.25rem;
		gap: 1rem;
	}
	.wordmark {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		font-family: var(--font-display-stack);
		font-size: 1.65rem;
		letter-spacing: -0.02em;
		line-height: 1;
		color: var(--ink);
		text-decoration: none;
	}
	.wordmark:hover { color: var(--accent); }
	.mark { flex: none; display: block; box-shadow: var(--shadow-paper); transition: transform 0.25s ease; }
	.wordmark:hover .mark { transform: translateY(-2px); }
	.logo {
		height: 2rem;
		width: auto;
		display: block;
		box-shadow: none;
	}
	.internal-links {
		display: flex;
		gap: 2.25rem;
		justify-self: center;
	}

	.controls {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.ctrl-btn {
		background: transparent;
		border: none;
		border-radius: 0;
		cursor: pointer;
		padding: 0.5em 0.6em;
		color: var(--muted);
		transition: color 0.2s;
	}
	.ctrl-btn:hover { color: var(--accent); }
	#theme-toggle { font-size: 14px; letter-spacing: 0; }

	/* Show sun in dark mode, moon in light mode */
	:global([data-theme="dark"]) .icon-sun { display: inline; }
	:global([data-theme="dark"]) .icon-moon { display: none; }
	:global([data-theme="light"]) .icon-sun { display: none; }
	:global([data-theme="light"]) .icon-moon { display: inline; }
	.icon-sun { display: none; }
	.icon-moon { display: inline; }

	@media (max-width: 640px) {
		header { padding: 0 1em; }
		nav {
			grid-template-columns: 1fr auto;
			grid-template-areas: 'brand controls' 'links links';
			padding: 0.75rem 0 0.4rem;
			row-gap: 0.4rem;
		}
		.wordmark { grid-area: brand; font-size: 1.4rem; }
		.controls { grid-area: controls; }
		.internal-links { grid-area: links; gap: 1.5rem; }
	}
</style>
