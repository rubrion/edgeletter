---
import { and, eq, gt, isNull } from 'drizzle-orm';
import AppLayout from '../../layouts/AppLayout.astro';
import { getDbInstance, loginTokens, memberships, users } from '../../db';
import { EMAIL_RE, issueLoginToken, normalizeEmail } from '../../lib/auth';
import { sendInvite } from '../../lib/auth-email';
import { allow } from '../../lib/ratelimit';

const { user, publication } = Astro.locals as Required<App.Locals>;
const db = getDbInstance();
let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = form.get('action');
	if (action === 'invite') {
		const email = normalizeEmail(String(form.get('email') ?? ''));
		const role = form.get('role') === 'owner' ? 'owner' : 'editor';
		if (!EMAIL_RE.test(email)) error = 'Enter a valid email address.';
		else if (!(await allow(`invite:${publication.id}`))) error = 'Too many invitations at once. Try again in a minute.';
		else {
			const token = await issueLoginToken({ email, purpose: 'invite', publicationId: publication.id, role });
			try {
				await sendInvite(email, `${Astro.url.origin}/auth/verify?token=${token}`, publication.name, user.name ?? user.email);
				notice = `Invitation sent to ${email}.`;
			} catch {
				error = 'Could not send the invitation email.';
			}
		}
	} else if (action === 'remove') {
		const target = String(form.get('user') ?? '');
		const owners = await db
			.select({ id: memberships.userId })
			.from(memberships)
			.where(and(eq(memberships.publicationId, publication.id), eq(memberships.role, 'owner')));
		if (owners.length === 1 && owners[0]!.id === target) error = 'A publication needs at least one owner.';
		else {
			await db.delete(memberships).where(and(eq(memberships.publicationId, publication.id), eq(memberships.userId, target)));
			notice = 'Member removed.';
		}
	}
}

const team = await db
	.select({ id: users.id, email: users.email, name: users.name, role: memberships.role })
	.from(memberships)
	.innerJoin(users, eq(users.id, memberships.userId))
	.where(eq(memberships.publicationId, publication.id));
const pending = await db
	.select({ email: loginTokens.email, role: loginTokens.role, expiresAt: loginTokens.expiresAt })
	.from(loginTokens)
	.where(
		and(
			eq(loginTokens.publicationId, publication.id),
			eq(loginTokens.purpose, 'invite'),
			isNull(loginTokens.usedAt),
			gt(loginTokens.expiresAt, new Date()),
		),
	);
---

<AppLayout title="Team" current="members">
	<div class="card app-card">
		<header class="page-head">
			<span class="eyebrow">Many hands</span>
			<h1>Team</h1>
			<p class="sub">Editors write, publish and see subscribers. Owners also manage settings, plan, domain, keys and the team.</p>
		</header>
		{notice && <div class="alert ok">{notice}</div>}
		{error && <div class="alert err">{error}</div>}

		<h2>Members</h2>
		<table>
			<thead><tr><th>Person</th><th>Role</th><th></th></tr></thead>
			<tbody>
				{team.map((m) => (
					<tr>
						<td>{m.name ? <>{m.name} <span class="muted">{m.email}</span></> : m.email}{m.id === user.id && <span class="muted"> (you)</span>}</td>
						<td><span class="badge">{m.role}</span></td>
						<td style="text-align:right">
							<form method="post" class="inline-form">
								<input type="hidden" name="action" value="remove" />
								<input type="hidden" name="user" value={m.id} />
								<button type="submit" class="btn-link" style="background:none;color:var(--accent);border:0;padding:0;letter-spacing:0;text-transform:none;font-size:0.9rem">Remove</button>
							</form>
						</td>
					</tr>
				))}
			</tbody>
		</table>
		{pending.length > 0 && (
			<p class="muted" style="margin-top:1rem">Pending: {pending.map((p) => `${p.email} (${p.role})`).join(', ')}</p>
		)}

		<h2>Invite</h2>
		<form method="post" class="row">
			<input type="hidden" name="action" value="invite" />
			<div class="field">
				<label for="email">Email</label>
				<input id="email" name="email" type="email" required placeholder="colleague@example.com" />
			</div>
			<div class="field" style="flex:0 0 160px;min-width:140px">
				<label for="role">Role</label>
				<select id="role" name="role"><option value="editor">Editor</option><option value="owner">Owner</option></select>
			</div>
			<button type="submit">Send invite</button>
		</form>
	</div>
</AppLayout>
