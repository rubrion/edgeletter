---
import { type Lang, useTranslations } from '../i18n';

interface Props {
  heading?: string;
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const heading = Astro.props.heading ?? t('subscribe.heading');
---

<div class="letter card">
	<span class="eyebrow">{t('subscribe.eyebrow')}</span>
	<h3 class="display">{heading}</h3>
	<p class="note">{t('subscribe.note')}</p>
	<form
		class="subscribe-form"
		method="POST"
		action="/api/subscribe"
		data-subscribe
		data-msg-loading={t('subscribe.loading')}
		data-msg-success={t('subscribe.success')}
		data-msg-already={t('subscribe.alreadyActive')}
		data-msg-network={t('subscribe.errorNetwork')}
	>
		<label class="sr-only" for="subscribe-email">{t('subscribe.emailLabel')}</label>
		<input
			id="subscribe-email"
			type="email"
			name="email"
			placeholder={t('subscribe.placeholder')}
			autocomplete="email"
			required
		/>
		<button type="submit" class="btn">{t('subscribe.button')}</button>
	</form>
	<p class="subscribe-status" data-subscribe-status aria-live="polite"></p>
</div>

<script>
	const form = document.querySelector<HTMLFormElement>('form[data-subscribe]');
	const status = document.querySelector<HTMLElement>('[data-subscribe-status]');
	if (form && status) {
		const msgLoading = form.dataset.msgLoading ?? 'Subscribing…';
		const msgSuccess = form.dataset.msgSuccess ?? 'Check your inbox to confirm.';
		const msgAlready = form.dataset.msgAlready ?? "You're already subscribed.";
		const msgNetwork = form.dataset.msgNetwork ?? 'Network error.';

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			status.textContent = msgLoading;
			const email = (form.elements.namedItem('email') as HTMLInputElement).value;
			try {
				const res = await fetch('/api/subscribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email }),
				});
				const j = (await res.json().catch(() => ({}))) as { error?: string; alreadyActive?: boolean };
				if (res.ok) {
					status.textContent = j.alreadyActive ? msgAlready : msgSuccess;
					form.reset();
				} else {
					status.textContent = j.error ?? `Failed (${res.status}).`;
				}
			} catch (err) {
				status.textContent = err instanceof Error ? err.message : msgNetwork;
			}
		});
	}
</script>

<style>
	.letter {
		position: relative;
		max-width: 560px;
		margin: 0 auto;
		padding: 2.75rem 2.5rem 2.25rem;
		text-align: center;
	}
	.letter h3 {
		margin: 0 0 0.6rem;
		font-size: 2.4rem;
	}
	.note {
		margin: 0 0 1.75rem;
		color: var(--muted);
		font-style: italic;
		font-size: 0.95rem;
	}
	.subscribe-form {
		display: flex;
		gap: 0.75rem;
		align-items: stretch;
		max-width: 440px;
		margin: 0 auto;
	}
	.subscribe-form input[type='email'] {
		flex: 1;
		min-width: 0;
		padding: 0.7rem 0.1rem;
		border: none;
		border-bottom: 1px solid var(--ink);
		border-radius: 0;
		background: transparent;
		color: var(--ink);
		font-size: 1rem;
		font-style: italic;
	}
	.subscribe-form input[type='email']::placeholder { color: var(--muted); opacity: 0.8; }
	.subscribe-form input[type='email']:focus { outline: none; border-bottom-color: var(--accent); }
	.subscribe-status {
		min-height: 1.4em;
		margin: 1rem 0 0;
		font-size: 0.9rem;
		font-style: italic;
		color: var(--muted);
	}
	@media (max-width: 520px) {
		.letter { padding: 2.25rem 1.25rem 1.75rem; }
		.letter h3 { font-size: 1.9rem; }
		.subscribe-form { flex-direction: column; }
	}
</style>
