---
import { membershipsOf } from '../lib/auth';
import { loadSettings } from '../lib/settings';
import { publicationOrigin } from '../lib/tenant';
import LogoMark from './LogoMark.astro';

type Key = 'posts' | 'subscribers' | 'stats' | 'widget' | 'settings' | 'members' | 'keys' | 'billing' | 'domain' | 'staff' | 'home';

interface Props {
  current?: Key;
}

const { current } = Astro.props;
const { user, role, publication } = Astro.locals;

const settings = publication ? await loadSettings(publication.id) : null;
const themeColor = settings?.themePrimaryColor ?? '#B44A27';
const mine = user ? await membershipsOf(user.id) : [];
const owner = role === 'owner';

const links: { key: Key; href: string; label: string; show: boolean }[] = [
  { key: 'posts', href: '/admin', label: 'Posts', show: !!publication },
  { key: 'subscribers', href: '/admin/subscribers', label: 'Subscribers', show: !!publication },
  { key: 'stats', href: '/admin/stats', label: 'Stats', show: !!publication },
  { key: 'settings', href: '/admin/settings', label: 'Settings', show: !!publication && owner },
  { key: 'widget', href: '/admin/widget', label: 'Widget', show: !!publication && owner },
  { key: 'members', href: '/members', label: 'Team', show: !!publication && owner },
  { key: 'keys', href: '/keys', label: 'API keys', show: !!publication && owner },
  { key: 'domain', href: '/domain', label: 'Domain', show: !!publication && owner },
  { key: 'billing', href: '/billing', label: 'Plan', show: !!publication && owner },
  { key: 'staff', href: '/staff', label: 'Staff', show: !!user?.isStaff },
];
---


<nav class="admin-appbar" style={`--theme: ${themeColor}`}>
  <a href="/" class="brand"><LogoMark size={26} class="mark" />{publication?.name ?? 'EdgeLetter'}<span class="brand-sub">Studio</span></a>
  {mine.length > 1 && (
    <form method="get" action="/admin" class="switcher">
      <label class="sr-only" for="pub-switch">Publication</label>
      <select id="pub-switch" name="pub" onchange="this.form.submit()">
        {mine.map((m) => <option value={m.publication.id} selected={m.publication.id === publication?.id}>{m.publication.name}</option>)}
      </select>
    </form>
  )}
  <div class="links">
    {links.filter((l) => l.show).map((l) => (
      <a href={l.href} class:list={['nav-link', current === l.key && 'active']}>{l.label}</a>
    ))}
  </div>
  {publication && <a href={publicationOrigin(Astro.url, publication)} class="nav-link view" target="_blank" rel="noopener">View site ↗</a>}
  <form method="post" action="/signout" class="signout-form"><button type="submit" class="signout">Sign out</button></form>
</nav>

<style>
  .admin-appbar {
    view-transition-name: admin-bar;
    --accent: var(--theme);
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 0 1.75rem;
    min-height: 3.75rem;
    background: var(--card);
    border-bottom: var(--hairline);
    box-shadow: var(--shadow-paper);
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-display-stack);
    font-weight: var(--display-weight);
    word-spacing: var(--display-words);
    font-size: 1.5rem;
    letter-spacing: var(--display-tracking);
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
  }
  .brand:hover { color: var(--ink); }
  .brand { align-items: center; }
  .brand .mark { flex: none; display: block; box-shadow: var(--shadow-paper); }
  .brand-sub {
    font-family: var(--font-eyebrow-stack);
    font-style: italic;
    font-weight: 500;
    font-size: 1.15rem;
    letter-spacing: 0;
    color: var(--accent);
  }
  .links {
    display: flex;
    gap: 1.75rem;
    flex: 1;
  }
  .nav-link, .signout {
    position: relative;
    padding: 0.4rem 0;
    color: var(--muted);
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-bottom: 1px solid var(--accent);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }
  .nav-link:hover, .nav-link.active { color: var(--accent); }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }
  .signout::before { content: '[\00a0'; }
  .signout::after { content: '\00a0]'; }
  .signout:hover { color: var(--accent); }
  .signout-form { margin: 0; }
  button.signout { background: none; border: none; padding: 0.4rem 0; cursor: pointer; font-family: inherit; }
  .switcher { margin: 0; }
  .switcher select { width: auto; padding: 0.35rem 2rem 0.35rem 0.6rem; font-size: 0.85rem; }
  .view { white-space: nowrap; }

  @media (max-width: 720px) {
    .admin-appbar { flex-wrap: wrap; gap: 0.5rem 1.25rem; padding: 0.75rem 1rem; }
    .links { order: 3; flex-basis: 100%; gap: 1.25rem; overflow-x: auto; }
  }
</style>
