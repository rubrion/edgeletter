{
	"compatibility_date": "2026-04-29",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "web-rubrion-edgeletter",
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
	},
	"observability": {
		"enabled": true,
	},
	// Platform hosts: apex + app as custom domains; every <handle> subdomain and
	// every Cloudflare-for-SaaS custom hostname reaches the Worker via the zone
	// route. The pre-platform address stays attached as a redirecting alias.
	"routes": [
		{ "pattern": "edgeletter.blog", "custom_domain": true },
		{ "pattern": "app.edgeletter.blog", "custom_domain": true },
		{ "pattern": "*/*", "zone_name": "edgeletter.blog" },
		{ "pattern": "edgeletter.rubrion.ai", "custom_domain": true },
	],
	"vars": {
		"PLATFORM_DOMAIN": "edgeletter.blog",
		"MAIL_FROM_DOMAIN": "mail.edgeletter.blog",
		"CUSTOM_DOMAIN_TARGET": "customers.edgeletter.blog",
		"CF_ZONE_ID": "b7982b3858faae64fb1485148a45e60e",
		// Platform ceiling on custom hostnames; stays inside Cloudflare's 100 free.
		"MAX_CUSTOM_HOSTNAMES": "90",
		"MEDIA_PUBLIC_BASE": "https://media.rubrion.ai",
		"TURNSTILE_SITE_KEY": "0x4AAAAAADMKgjDCOeL0zVJj",
	},
	"triggers": { "crons": ["17 4 * * *"] },
	// Sign-in, invites and reports: 5 attempts per key per minute.
	"ratelimits": [
		{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
	],
	// Campaign emails are fanned out through this queue (see src/lib/email-queue.ts).
	"queues": {
		"producers": [
			{ "binding": "EMAIL_QUEUE", "queue": "edgeletter-email" },
		],
		"consumers": [
			{
				"queue": "edgeletter-email",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "edgeletter-email-dlq",
			},
		],
	},
	"ai": {
		"binding": "AI",
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "rubrion",
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rubrion-edgeletter",
			"database_id": "02fed011-4f3d-4796-949a-6a9def359f3a",
			"migrations_dir": "./drizzle",
		},
		{
			"binding": "rubrion_edgeletter",
			"database_name": "rubrion-edgeletter",
			"database_id": "02fed011-4f3d-4796-949a-6a9def359f3a",
			"remote": true
		},
	],
}