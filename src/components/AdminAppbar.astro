---
import { loadSettings } from '../lib/settings';
import LogoMark from './LogoMark.astro';

interface Props {
  current?: 'posts' | 'subscribers' | 'widget' | 'settings';
}

const { current } = Astro.props;

const settings = await loadSettings();
const themeColor = settings.themePrimaryColor;
const clientName = settings.clientName;

const links: { key: NonNullable<Props['current']>; href: string; label: string }[] = [
  { key: 'posts', href: '/admin', label: 'Posts' },
  { key: 'subscribers', href: '/admin/subscribers', label: 'Subscribers' },
  { key: 'widget', href: '/admin/widget', label: 'Widget' },
  { key: 'settings', href: '/admin/settings', label: 'Settings' },
];
---

<nav class="admin-appbar" style={`--theme: ${themeColor}`}>
  <a href="/admin" class="brand"><LogoMark size={26} class="mark" />{clientName}<span class="brand-sub">Studio</span></a>
  <div class="links">
    {links.map((l) => (
      <a href={l.href} class:list={['nav-link', current === l.key && 'active']}>{l.label}</a>
    ))}
  </div>
  <a href="/api/admin/logout" id="admin-appbar-logout" class="signout">Sign out</a>
</nav>

<script>
  const logout = document.getElementById('admin-appbar-logout');
  logout?.addEventListener('click', async (e) => {
    e.preventDefault();
    await fetch('/api/admin/logout', { method: 'POST', credentials: 'same-origin' });
    window.location.href = '/admin/login';
  });
</script>

<style>
  .admin-appbar {
    view-transition-name: admin-bar;
    --accent: var(--theme);
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 0 1.75rem;
    min-height: 3.75rem;
    background: var(--card);
    border-bottom: var(--hairline);
    box-shadow: var(--shadow-paper);
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-display-stack);
    font-weight: var(--display-weight);
    word-spacing: var(--display-words);
    font-size: 1.5rem;
    letter-spacing: var(--display-tracking);
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
  }
  .brand:hover { color: var(--ink); }
  .brand { align-items: center; }
  .brand .mark { flex: none; display: block; box-shadow: var(--shadow-paper); }
  .brand-sub {
    font-family: var(--font-eyebrow-stack);
    font-style: italic;
    font-weight: 500;
    font-size: 1.15rem;
    letter-spacing: 0;
    color: var(--accent);
  }
  .links {
    display: flex;
    gap: 1.75rem;
    flex: 1;
  }
  .nav-link, .signout {
    position: relative;
    padding: 0.4rem 0;
    color: var(--muted);
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-bottom: 1px solid var(--accent);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }
  .nav-link:hover, .nav-link.active { color: var(--accent); }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }
  .signout::before { content: '[\00a0'; }
  .signout::after { content: '\00a0]'; }
  .signout:hover { color: var(--accent); }

  @media (max-width: 720px) {
    .admin-appbar { flex-wrap: wrap; gap: 0.5rem 1.25rem; padding: 0.75rem 1rem; }
    .links { order: 3; flex-basis: 100%; gap: 1.25rem; overflow-x: auto; }
  }
</style>
