---
import { loadSettings } from '../../lib/settings';
import AdminAppbar from '../../components/AdminAppbar.astro';
import AdminHead from '../../components/AdminHead.astro';
import { getLang } from '../../i18n';
import { studio } from '../../i18n/studio';


const settings = await loadSettings(Astro.locals.publication.id);
const saved = Astro.url.searchParams.get('saved') === '1';
const error = Astro.url.searchParams.get('error');
const themeColor = settings.themePrimaryColor;

const listed = Astro.locals.publication.listed;

const lang = getLang(Astro.request);
const t = studio(lang);

const lightColors = [
  { key: 'colorBgLight', label: t('set.c.bg') },
  { key: 'colorHeaderBgLight', label: t('set.c.header') },
  { key: 'colorHeadingLight', label: t('set.c.heading') },
  { key: 'colorTextLight', label: t('set.c.text') },
  { key: 'colorMutedLight', label: t('set.c.muted') },
  { key: 'colorBorderLight', label: t('set.c.border') },
];

const darkColors = [
  { key: 'colorBgDark', label: t('set.c.bg') },
  { key: 'colorHeaderBgDark', label: t('set.c.header') },
  { key: 'colorHeadingDark', label: t('set.c.heading') },
  { key: 'colorTextDark', label: t('set.c.text') },
  { key: 'colorMutedDark', label: t('set.c.muted') },
  { key: 'colorBorderDark', label: t('set.c.border') },
];
---
<!doctype html>
<html lang={lang}>
<head>
  <AdminHead title={`Settings — ${settings.clientName}`} />
  <style is:global>
    .color-row { display: flex; align-items: center; gap: 0.6rem; }
    .color-row input[type="text"] { flex: 1; max-width: 150px; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.85rem; }
    .color-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 1rem 1.5rem; }
    .color-grid .field { margin: 0; }
    .check { display: flex; align-items: center; gap: 0.55rem; font-size: 0.98rem; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--text); }
    .email-row { display: flex; align-items: stretch; }
    .email-row input[type="text"] { border-right: none; }
    .email-row .domain {
      display: flex; align-items: center; padding: 0 0.85rem;
      background: var(--paper); border: 1px solid rgba(42, 35, 29, 0.2);
      color: var(--muted); font-size: 0.88rem; font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    }
  </style>
</head>
<body style={`--theme: ${themeColor}`}>
  <AdminAppbar current="settings" />
  <div class="wrap">
    <div class="card">
      <header class="page-head">
        <span class="eyebrow">{t('set.eyebrow')}</span>
        <h1>{t('set.heading')}</h1>
        <p class="sub">{t('set.lead')}</p>
      </header>

      {saved && <div class="alert ok">{t('common.saved')}</div>}
      {error && <div class="alert err">{error}</div>}

      <form method="POST" action="/api/admin/settings">
        <h2>{t('set.brand')}</h2>

        <div class="field">
          <label for="clientName">{t('set.brandName')}</label>
          <input type="text" id="clientName" name="clientName" value={settings.clientName} />
        </div>

        <div class="field">
          <label for="clientTagline">{t('set.tagline')}</label>
          <textarea id="clientTagline" name="clientTagline">{settings.clientTagline}</textarea>
        </div>

        <div class="field">
          <label for="clientLogoUrl">{t('set.logo')}</label>
          <input type="url" id="clientLogoUrl" name="clientLogoUrl" value={settings.clientLogoUrl} placeholder="https://..." />
          <div class="hint">{t('set.logoHint')}</div>
        </div>

        <div class="field">
          <label for="clientFaviconUrl">{t('set.favicon')}</label>
          <input type="url" id="clientFaviconUrl" name="clientFaviconUrl" value={settings.clientFaviconUrl} placeholder="https://..." />
        </div>

        <h2>{t('set.about')}</h2>

        <div class="field">
          <label for="aboutBodyEn">{t('set.aboutEn')}</label>
          <textarea id="aboutBodyEn" name="aboutBodyEn" rows="4">{settings.aboutBodyEn}</textarea>
          <div class="hint" set:html={t('set.aboutHint', { name: '<code>{name}</code>' })} />
        </div>

        <div class="field">
          <label for="aboutBodyPt">{t('set.aboutPt')}</label>
          <textarea id="aboutBodyPt" name="aboutBodyPt" rows="4">{settings.aboutBodyPt}</textarea>
          <div class="hint" set:html={t('set.aboutHint', { name: '<code>{name}</code>' })} />
        </div>

        <h2>{t('set.discovery')}</h2>

        <div class="field">
          <label class="check">
            <input type="hidden" name="listed" value="0" />
            <input type="checkbox" name="listed" value="1" checked={listed} />
            {t('set.listed')}
          </label>
          <div class="hint">{t('set.listedHint')}</div>
        </div>

        <h2>{t('set.colorsPrimary')}</h2>

        <div class="field">
          <label for="themePrimaryColor">{t('set.primary')}</label>
          <div class="color-row">
            <input type="color" data-picker-for="themePrimaryColor" value={settings.themePrimaryColor} />
            <input type="text" id="themePrimaryColor" name="themePrimaryColor" value={settings.themePrimaryColor} pattern="^#[0-9a-fA-F]{3,8}$" />
          </div>
          <div class="hint">{t('set.primaryHint')}</div>
        </div>

        <h2>{t('set.light')}</h2>
        <div class="color-grid">
          {lightColors.map(({ key, label }) => (
            <div class="field">
              <label for={key}>{label}</label>
              <div class="color-row">
                <input type="color" data-picker-for={key} value={settings[key]} />
                <input type="text" id={key} name={key} value={settings[key]} pattern="^#[0-9a-fA-F]{3,8}$" />
              </div>
            </div>
          ))}
        </div>

        <h2>{t('set.dark')}</h2>
        <div class="color-grid">
          {darkColors.map(({ key, label }) => (
            <div class="field">
              <label for={key}>{label}</label>
              <div class="color-row">
                <input type="color" data-picker-for={key} value={settings[key]} />
                <input type="text" id={key} name={key} value={settings[key]} pattern="^#[0-9a-fA-F]{3,8}$" />
              </div>
            </div>
          ))}
        </div>

        <div class="actions">
          <button type="submit">{t('common.save')}</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Two-way bind every color picker with its sibling hex text input.
    document.querySelectorAll<HTMLInputElement>('input[type="color"][data-picker-for]').forEach((picker) => {
      const targetId = picker.dataset.pickerFor;
      if (!targetId) return;
      const text = document.getElementById(targetId) as HTMLInputElement | null;
      if (!text) return;
      picker.addEventListener('input', () => { text.value = picker.value; });
      text.addEventListener('input', () => {
        if (/^#[0-9a-fA-F]{6}$/.test(text.value)) picker.value = text.value;
      });
    });
  </script>
</body>
</html>
