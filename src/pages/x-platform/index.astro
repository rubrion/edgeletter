---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { excerptOf, recentListedPosts } from '../../lib/discovery';
import { PLAN_LIMITS, PRO_PRICE } from '../../lib/plans';
import { platformOrigin, publicationOrigin } from '../../lib/tenant';
import { getLang } from '../../i18n';
import { studio } from '../../i18n/studio';

const app = platformOrigin(Astro.url, 'app');
const lang = getLang(Astro.request);
const t = studio(lang);
const loc = lang === 'pt-BR' ? 'pt-BR' : 'en-US';
const latest = await recentListedPosts(6);
const fmt = (d: Date | null) => (d ? d.toLocaleDateString(loc, { month: 'short', day: 'numeric', year: 'numeric' }) : '');
---

<PlatformLayout title={t('pf.title')} description={t('pf.description')}>
	<main>
		<section class="hero">
			<span class="eyebrow rise" style="--i:0">{t('pf.heroEyebrow')}</span>
			<h1 class="rise" style="--i:1">{t('pf.heroTitle1')}<br />{t('pf.heroTitle2')}</h1>
			<div class="ornament rise" style="--i:2" aria-hidden="true">✦</div>
			<p class="tagline rise" style="--i:3">{t('pf.heroLead')}</p>
			<p class="rise" style="--i:4"><a class="btn" href={`${app}/signin`}>{t('pf.start')}</a></p>
		</section>
	</main>

	<section class="features pocket">
		<span class="pocket-label deboss" aria-hidden="true">{t('pf.how')}</span>
		<div class="grid">
			<div class="card lift reveal from-pocket" style="--i:1"><span class="micro bracket">{t('pf.write')}</span><h3>{t('pf.writeTitle')}</h3><p>{t('pf.writeBody')}</p></div>
			<div class="card lift reveal from-pocket" style="--i:2"><span class="micro bracket">{t('pf.send')}</span><h3>{t('pf.sendTitle')}</h3><p>{t('pf.sendBody')}</p></div>
			<div class="card lift reveal from-pocket" style="--i:3"><span class="micro bracket">{t('pf.own')}</span><h3>{t('pf.ownTitle')}</h3><p>{t('pf.ownBody')}</p></div>
		</div>
	</section>

	{latest.length > 0 && (
		<main class="latest">
			<header class="head"><span class="eyebrow">{t('pf.freshEyebrow')}</span><h2>{t('pf.freshTitle')}</h2></header>
			<ul class="posts">
				{latest.map((p) => (
					<li class="reveal">
						<a class="card lift post" href={p.canonicalUrl ?? `${publicationOrigin(Astro.url, p)}/blog/${p.slug}`}>
							<span class="micro" style="color:var(--accent)">{p.pubName}</span>
							<strong>{p.title}</strong>
							<span class="ex">{excerptOf(p.contentMd)}…</span>
							<span class="micro" style="color:var(--muted)">{fmt(p.publishedAt)}</span>
						</a>
					</li>
				))}
			</ul>
			<p style="text-align:center"><a class="btn secondary" href="/explore">{t('pf.exploreAll')}</a></p>
		</main>
	)}

	<main class="pricing">
		<header class="head"><span class="eyebrow">{t('pf.plainTerms')}</span><h2>{t('pf.freeToStart')}</h2></header>
		<div class="plans">
			<div class="card plan"><span class="micro bracket">{t('pf.free')}</span><p class="price"><strong>{t('pf.free')}</strong> <span>{t('pf.forever')}</span></p><ul><li>{t('pf.subs', { n: PLAN_LIMITS.free.subscribers.toLocaleString(loc) })}</li><li>{t('pf.emails', { n: PLAN_LIMITS.free.emailsPerMonth.toLocaleString(loc) })}</li><li>{t('pf.handleDomain')}</li></ul></div>
			<div class="card plan featured"><span class="micro bracket">{t('pf.pro')}</span><p class="price"><strong>{PRO_PRICE.monthly.brl}</strong>{t('pf.perMonth')} <span>{t('pf.outsideBrazil', { usd: PRO_PRICE.monthly.usd })}</span></p><p class="launch">{t('pf.launch')}</p><ul><li>{t('pf.subs', { n: PLAN_LIMITS.pro.subscribers.toLocaleString(loc) })}</li><li>{t('pf.emails', { n: PLAN_LIMITS.pro.emailsPerMonth.toLocaleString(loc) })}</li><li>{t('pf.ownDomain')}</li><li>{t('pf.noWatermark')}</li></ul></div>
		</div>
	</main>

	<style>
		.hero { text-align: center; padding: 3em 0 2em; }
		.hero h1 { font-size: clamp(2.6rem, 7vw, 5rem); margin: 0; }
		.tagline { max-width: 34em; margin: 0 auto 2rem; font-style: italic; font-size: 1.15em; color: var(--muted); }
		.features { padding: 7rem 1.25rem 4rem; }
		.pocket-label { position: absolute; top: 3rem; left: 0; right: 0; text-align: center; font-family: var(--font-display-stack); font-style: italic; font-weight: 500; font-size: clamp(4rem, 13vw, 10rem); line-height: 1; pointer-events: none; }
		.grid { position: relative; z-index: 1; max-width: 960px; margin: 5rem auto 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; }
		.grid .card { padding: 1.75rem; }
		.grid h3 { font-size: 1.6rem; margin: 0.6rem 0 0.5rem; }
		.grid p { margin: 0; font-size: 0.98rem; color: var(--text); }
		.head { text-align: center; margin-bottom: 2rem; }
		.head h2 { margin: 0; }
		.posts { list-style: none; padding: 0; margin: 0 0 2.5rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
		.post { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.5rem 1.6rem; text-decoration: none; color: var(--text); height: 100%; box-sizing: border-box; }
		.post strong { font-family: var(--font-display-stack); font-weight: 500; font-size: 1.5rem; line-height: 1.15; color: var(--ink); }
		.post .ex { font-style: italic; font-size: 0.95rem; color: var(--muted); }
		.pricing { padding-top: 1rem; }
		.plans { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
		.plan { padding: 1.75rem; }
		.plan.featured { border-color: var(--accent); }
		.plan ul { margin: 0.8rem 0 0; padding-left: 1.1rem; }
		.price { margin: 0.8rem 0 0; }
		.price strong { font-family: var(--font-display-stack); font-weight: 500; font-size: 2rem; color: var(--ink); }
		.price span, .launch { color: var(--muted); font-style: italic; font-size: 0.92rem; }
		.launch { margin: 0.2rem 0 0; }
		@media (max-width: 640px) { .posts, .plans { grid-template-columns: 1fr; } }
	</style>
</PlatformLayout>
