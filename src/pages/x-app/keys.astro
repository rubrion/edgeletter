---
import { and, desc, eq, isNull } from 'drizzle-orm';
import AppLayout from '../../layouts/AppLayout.astro';
import { apiKeys, getDbInstance } from '../../db';
import { createApiKey, type ApiScope } from '../../lib/auth';
import { publicationOrigin } from '../../lib/tenant';

const { publication } = Astro.locals as Required<App.Locals>;
const db = getDbInstance();
let created: { key: string; scope: ApiScope } | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	if (form.get('action') === 'create') {
		const scope: ApiScope = form.get('scope') === 'subscribe' ? 'subscribe' : 'publish';
		const label = String(form.get('label') ?? '').trim().slice(0, 60) || null;
		created = { key: await createApiKey(publication.id, scope, label), scope };
	} else if (form.get('action') === 'revoke') {
		await db
			.update(apiKeys)
			.set({ revokedAt: new Date() })
			.where(and(eq(apiKeys.id, String(form.get('id') ?? '')), eq(apiKeys.publicationId, publication.id)));
	}
}

const keys = await db
	.select()
	.from(apiKeys)
	.where(and(eq(apiKeys.publicationId, publication.id), isNull(apiKeys.revokedAt)))
	.orderBy(desc(apiKeys.createdAt));
const origin = publicationOrigin(Astro.url, publication);
const fmt = (d: Date | null) => (d ? d.toISOString().slice(0, 10) : '—');
---

<AppLayout title="API keys" current="keys">
	<div class="card app-card">
		<header class="page-head">
			<span class="eyebrow">Machine to machine</span>
			<h1>API keys</h1>
			<p class="sub">Let your own site publish posts or subscribe readers on your behalf.</p>
		</header>

		{created && (
			<div class="stack" style="margin-bottom:1.5rem">
				<div class="alert ok">New {created.scope} key — copy it now, it won't be shown again.</div>
				<div class="secret">{created.key}</div>
			</div>
		)}

		<h2>Active keys</h2>
		{keys.length === 0 ? <p class="empty">No keys yet.</p> : (
			<table>
				<thead><tr><th>Key</th><th>Scope</th><th>Label</th><th>Last used</th><th></th></tr></thead>
				<tbody>
					{keys.map((k) => (
						<tr>
							<td><code>{k.prefix}…</code></td>
							<td><span class="badge">{k.scope}</span></td>
							<td>{k.label ?? <span class="muted">—</span>}</td>
							<td>{fmt(k.lastUsedAt)}</td>
							<td style="text-align:right">
								<form method="post" class="inline-form">
									<input type="hidden" name="action" value="revoke" /><input type="hidden" name="id" value={k.id} />
									<button type="submit" style="background:none;color:var(--accent);border:0;padding:0;letter-spacing:0;text-transform:none;font-size:0.9rem">Revoke</button>
								</form>
							</td>
						</tr>
					))}
				</tbody>
			</table>
		)}

		<h2>New key</h2>
		<form method="post" class="row">
			<input type="hidden" name="action" value="create" />
			<div class="field" style="flex:0 0 170px;min-width:150px">
				<label for="scope">Scope</label>
				<select id="scope" name="scope"><option value="publish">Publish</option><option value="subscribe">Subscribe</option></select>
			</div>
			<div class="field">
				<label for="label">Label</label>
				<input id="label" name="label" type="text" maxlength="60" placeholder="e.g. company website" />
			</div>
			<button type="submit">Create key</button>
		</form>

		<h2>Usage</h2>
		<p class="hint" style="font-size:0.9rem">Publish: <code>POST {origin}/api/publish</code> with <code>Authorization: Bearer &lt;key&gt;</code> and JSON <code>{'{'} title, slug, content_md, publish, send?, lang?, canonical_url?, published_at? {'}'}</code>.</p>
		<p class="hint" style="font-size:0.9rem">Subscribe: <code>POST {origin}/api/subscribe</code> with header <code>x-subscribe-key: &lt;key&gt;</code> and JSON <code>{'{'} email, lang? {'}'}</code> (skips the captcha; double opt-in still applies).</p>
	</div>
</AppLayout>
