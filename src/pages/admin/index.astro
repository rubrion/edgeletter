---
import { env } from 'cloudflare:workers';
import AdminEditor from '../../components/AdminEditor.tsx';
import AdminAppbar from '../../components/AdminAppbar.astro';
import AdminHead from '../../components/AdminHead.astro';
import { getDbInstance, aiUsage, campaigns, posts } from '../../db';
import { and, desc, eq, inArray } from 'drizzle-orm';
import { loadSettings } from '../../lib/settings';

const db = getDbInstance();
const recent = await db
  .select({
    id: posts.id,
    title: posts.title,
    slug: posts.slug,
    contentMd: posts.contentMd,
    isPublished: posts.isPublished,
    publishedAt: posts.publishedAt,
  })
  .from(posts)
  .where(eq(posts.publicationId, Astro.locals.publication.id))
  .orderBy(desc(posts.publishedAt))
  .limit(20);

// Aggregate the latest successful campaign per post (single round-trip).
const lastSentByPost = new Map<string, Date>();
if (recent.length > 0) {
  const rows = await db
    .select({
      postId: campaigns.postId,
      sentAt: campaigns.sentAt,
      status: campaigns.status,
    })
    .from(campaigns)
    .where(and(eq(campaigns.publicationId, Astro.locals.publication.id), inArray(campaigns.postId, recent.map((p) => p.id))));
  for (const c of rows) {
    if (c.status === 'failed') continue;
    const cur = lastSentByPost.get(c.postId);
    if (!cur || c.sentAt.getTime() > cur.getTime()) {
      lastSentByPost.set(c.postId, c.sentAt);
    }
  }
}

const settings = await loadSettings(Astro.locals.publication.id);
const themeColor = settings.themePrimaryColor;
const clientName = settings.clientName;

const aiLimitRaw = (env as unknown as { AI_REVIEW_DAILY_TOKEN_LIMIT?: string }).AI_REVIEW_DAILY_TOKEN_LIMIT;
const aiLimit = Number.parseInt(aiLimitRaw ?? '', 10);
let aiUsedToday = 0;
if (Number.isFinite(aiLimit) && aiLimit > 0) {
  const today = new Date().toISOString().slice(0, 10);
  try {
    const row = await db
      .select()
      .from(aiUsage)
      .where(and(eq(aiUsage.publicationId, Astro.locals.publication.id), eq(aiUsage.day, today)))
      .limit(1);
    aiUsedToday = row[0]?.tokensUsed ?? 0;
  } catch {
    aiUsedToday = 0;
  }
}
const initialAiUsage = Number.isFinite(aiLimit) && aiLimit > 0
  ? { used: aiUsedToday, limit: aiLimit }
  : null;

const recentSerialized = recent.map((p) => ({
  id: p.id,
  title: p.title,
  slug: p.slug,
  contentMd: p.contentMd,
  isPublished: p.isPublished,
  publishedAt: p.publishedAt ? p.publishedAt.toISOString() : null,
  lastSentAt: lastSentByPost.get(p.id)?.toISOString() ?? null,
}));
---
<!doctype html>
<html lang="en">
<head>
  <AdminHead title={`Admin — ${clientName}`} />
  <style is:global>
    html, body { height: 100%; }
    body { display: flex; flex-direction: column; }
    .ed-list button:hover { background: var(--card); }
    .ed-list button:hover span:first-child { color: var(--accent); }
    .ed-preview h1, .ed-preview h2, .ed-preview h3, .ed-preview h4 {
      font-family: var(--font-display-stack); font-weight: var(--display-weight); letter-spacing: var(--display-tracking); word-spacing: var(--display-words);
      font-weight: var(--display-weight);
      word-spacing: var(--display-words);
      line-height: 1.1; color: var(--ink); margin: 1.4em 0 0.5em;
      text-transform: none; border: none; padding: 0; font-size: revert;
    }
    .ed-preview h1 { font-size: 2.4rem; }
    .ed-preview h2 { font-size: 1.9rem; }
    .ed-preview h3 { font-size: 1.5rem; }
    .ed-preview > :first-child { margin-top: 0; }
    .ed-preview img, .ed-preview video { max-width: 100%; height: auto; box-shadow: var(--shadow-paper); }
    .ed-preview blockquote {
      margin: 1.5em 0; padding-left: 1.2em; border-left: 1px solid var(--accent);
      font-family: var(--font-display-stack); font-style: italic; font-size: 1.35em; line-height: 1.3; color: var(--ink);
      font-weight: var(--display-weight);
      word-spacing: var(--display-words);
    }
    .ed-preview pre { padding: 1rem 1.2rem; border: var(--hairline); background: var(--paper); overflow-x: auto; }
    .ed-preview pre code { background: none; padding: 0; }
    .ed-preview li::marker { color: var(--accent); }
  </style>
</head>
<body style={`--theme: ${themeColor}`}>
  <AdminAppbar current="posts" />
  <div style="flex: 1; min-height: 0;">
    <AdminEditor client:only="react" recent={recentSerialized} initialAiUsage={initialAiUsage} />
  </div>
</body>
</html>
