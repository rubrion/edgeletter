---
import { and, desc, eq, sql } from 'drizzle-orm';
import AdminAppbar from '../../components/AdminAppbar.astro';
import AdminHead from '../../components/AdminHead.astro';
import { campaigns, getDbInstance, posts, subscribers } from '../../db';
import { emailsThisMonth, formatBytes, limitsFor, mediaBytesUsed } from '../../lib/plans';
import { loadSettings } from '../../lib/settings';
import { getLang } from '../../i18n';
import { studio } from '../../i18n/studio';


const publication = Astro.locals.publication;
const lang = getLang(Astro.request);
const t = studio(lang);
const loc = lang === 'pt-BR' ? 'pt-BR' : 'en-US';
const db = getDbInstance();
const limits = limitsFor(publication);
const settings = await loadSettings(publication.id);

const [counts] = await db
	.select({
		active: sql<number>`sum(${subscribers.status} = 'active')`,
		pending: sql<number>`sum(${subscribers.status} = 'pending')`,
		gone: sql<number>`sum(${subscribers.status} = 'unsubscribed')`,
	})
	.from(subscribers)
	.where(eq(subscribers.publicationId, publication.id));

// New subscribers per week, last 12 weeks.
const since = Date.now() - 12 * 7 * 24 * 60 * 60 * 1000;
const weekly = await db
	.select({
		week: sql<number>`(${subscribers.createdAt} - ${since}) / ${7 * 24 * 60 * 60 * 1000}`,
		n: sql<number>`count(*)`,
	})
	.from(subscribers)
	.where(and(eq(subscribers.publicationId, publication.id), sql`${subscribers.createdAt} >= ${since}`))
	.groupBy(sql`1`);
const weeks = Array.from({ length: 12 }, (_, i) => Number(weekly.find((w) => Number(w.week) === i)?.n ?? 0));
const peak = Math.max(1, ...weeks);

const recent = await db
	.select({
		title: posts.title,
		sentAt: campaigns.sentAt,
		status: campaigns.status,
		recipients: campaigns.recipients,
		sent: campaigns.sent,
		failed: campaigns.failed,
		opened: sql<number>`(SELECT count(*) FROM campaign_deliveries d WHERE d.campaign_id = ${campaigns.id} AND d.opened_at IS NOT NULL)`,
		clicked: sql<number>`(SELECT count(*) FROM campaign_deliveries d WHERE d.campaign_id = ${campaigns.id} AND d.clicked_at IS NOT NULL)`,
	})
	.from(campaigns)
	.innerJoin(posts, eq(posts.id, campaigns.postId))
	.where(eq(campaigns.publicationId, publication.id))
	.orderBy(desc(campaigns.sentAt))
	.limit(20);

const used = await emailsThisMonth(publication.id);
const media = await mediaBytesUsed(publication.id);
const pct = (a: number, b: number) => `${Math.min(100, Math.round((a / Math.max(1, b)) * 100))}%`;
const rate = (a: number, b: number) => (b ? `${Math.round((a / b) * 100)}%` : '—');
---

<!doctype html>
<html lang={lang}>
<head>
	<AdminHead title={`${t('nav.stats')} — ${settings.clientName}`} />
	<style is:global>
		.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 0.5rem; }
		.tile { padding: 1.1rem 1.25rem; border: var(--hairline); background: #FBFAF7; }
		.tile .n { display: block; font-family: var(--font-display-stack); font-weight: 500; font-size: 2.2rem; line-height: 1.1; color: var(--ink); }
		.tile .l { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
		.bars { display: grid; grid-template-columns: repeat(12, 1fr); gap: 6px; align-items: end; height: 120px; padding-top: 0.5rem; }
		.bars span { display: block; background: var(--accent); min-height: 2px; }
		.bars-axis { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); margin-top: 0.4rem; }
		.usage { display: grid; gap: 1rem; }
		.usage .meta { display: flex; justify-content: space-between; font-size: 0.92rem; }
		.meter { height: 6px; background: rgba(var(--gray-light), 0.7); margin-top: 0.35rem; }
		.meter > span { display: block; height: 100%; background: var(--accent); }
	</style>
</head>
<body style={`--theme: ${settings.themePrimaryColor}`}>
	<AdminAppbar current="stats" />
	<div class="wrap">
		<div class="card">
			<header class="page-head">
				<span class="eyebrow">{t('stats.eyebrow')}</span>
				<h1>{t('nav.stats')}</h1>
			</header>

			<div class="tiles">
				<div class="tile"><span class="n">{Number(counts?.active ?? 0)}</span><span class="l">{t('stats.active')}</span></div>
				<div class="tile"><span class="n">{Number(counts?.pending ?? 0)}</span><span class="l">{t('stats.pending')}</span></div>
				<div class="tile"><span class="n">{Number(counts?.gone ?? 0)}</span><span class="l">{t('stats.unsub')}</span></div>
			</div>

			<h2>{t('stats.weeks')}</h2>
			<div class="bars" role="img" aria-label={`Weekly new subscribers: ${weeks.join(', ')}`}>
				{weeks.map((n) => <span style={`height:${Math.round((n / peak) * 100)}%`} title={`${n}`}></span>)}
			</div>
			<div class="bars-axis"><span>{t('stats.weeksAgo')}</span><span>{t('stats.thisWeek')}</span></div>

			<h2>{t('stats.campaigns')}</h2>
			{recent.length === 0 ? <p class="empty">{t('stats.none')}</p> : (
				<div style="overflow-x:auto">
					<table>
						<thead><tr><th>{t('stats.post')}</th><th>{t('stats.sent')}</th><th>{t('stats.delivered')}</th><th>{t('stats.failed')}</th><th>{t('stats.opened')}</th><th>{t('stats.clicked')}</th></tr></thead>
						<tbody>
							{recent.map((c) => (
								<tr>
									<td>{c.title}<br /><span class="badge">{c.status === 'sent' ? t('status.sent') : c.status}</span></td>
									<td>{c.sentAt.toLocaleDateString(loc, { day: 'numeric', month: 'short', year: 'numeric' })}</td>
									<td>{c.sent} / {c.recipients}</td>
									<td>{c.failed}</td>
									<td>{rate(Number(c.opened), c.sent)}</td>
									<td>{rate(Number(c.clicked), c.sent)}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			)}
			<p class="hint">{t('stats.opensNote')}</p>

			<h2>{t('stats.usage', { plan: t(publication.plan === 'pro' ? 'plan.pro' : 'plan.free') })}{limits.probation ? t('ov.firstWeek') : ''}</h2>
			<div class="usage">
				<div>
					<div class="meta"><span>{t('stats.emails')}</span><span>{used.toLocaleString(loc)} / {limits.emailsPerMonth.toLocaleString(loc)}</span></div>
					<div class="meter"><span style={`width:${pct(used, limits.emailsPerMonth)}`}></span></div>
				</div>
				<div>
					<div class="meta"><span>{t('stats.subscribers')}</span><span>{(Number(counts?.active ?? 0) + Number(counts?.pending ?? 0)).toLocaleString()} / {limits.subscribers.toLocaleString()}</span></div>
					<div class="meter"><span style={`width:${pct(Number(counts?.active ?? 0) + Number(counts?.pending ?? 0), limits.subscribers)}`}></span></div>
				</div>
				<div>
					<div class="meta"><span>{t('stats.media')}</span><span>{formatBytes(media)} / {formatBytes(limits.mediaBytes)}</span></div>
					<div class="meter"><span style={`width:${pct(media, limits.mediaBytes)}`}></span></div>
				</div>
			</div>
		</div>
	</div>
</body>
</html>
