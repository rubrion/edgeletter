---
import { and, count, desc, eq, sql } from 'drizzle-orm';
import AppLayout from '../../layouts/AppLayout.astro';
import { campaigns, getDbInstance, posts, subscribers } from '../../db';
import { membershipsOf } from '../../lib/auth';
import { emailsThisMonth, limitsFor } from '../../lib/plans';
import { publicationOrigin } from '../../lib/tenant';
import { getLang } from '../../i18n';
import { studio } from '../../i18n/studio';

const user = Astro.locals.user!;
const publication = Astro.locals.publication;
if (!publication) {
	const mine = await membershipsOf(user.id);
	if (mine.length === 0) return Astro.redirect('/onboarding');
}

const db = getDbInstance();
const pubId = publication.id;
const limits = limitsFor(publication);
const site = publicationOrigin(Astro.url, publication);

const [[subs], [postCounts], sent, recent] = await Promise.all([
	db.select({ n: count() }).from(subscribers).where(and(eq(subscribers.publicationId, pubId), eq(subscribers.status, 'active'))),
	db
		.select({ total: count(), published: sql<number>`sum(${posts.isPublished})` })
		.from(posts)
		.where(eq(posts.publicationId, pubId)),
	emailsThisMonth(pubId),
	db
		.select({
			id: posts.id,
			title: posts.title,
			slug: posts.slug,
			isPublished: posts.isPublished,
			publishedAt: posts.publishedAt,
			coverUrl: posts.coverUrl,
			excerpt: posts.excerpt,
			lang: posts.lang,
			sentAt: sql<number | null>`(SELECT max(${campaigns.sentAt}) FROM ${campaigns} WHERE ${campaigns.postId} = ${posts.id} AND ${campaigns.status} <> 'failed')`,
		})
		.from(posts)
		.where(eq(posts.publicationId, pubId))
		.orderBy(desc(sql`coalesce(${posts.publishedAt}, 9e15)`))
		.limit(8),
]);

const fmt = (d: Date | number | null) =>
	d ? new Date(d).toLocaleDateString(loc, { month: 'short', day: 'numeric', year: 'numeric' }) : '';
const pct = (a: number, b: number) => `${Math.min(100, Math.round((a / Math.max(1, b)) * 100))}%`;
const welcome = Astro.url.searchParams.get('welcome') === '1';
const lang = getLang(Astro.request);
const t = studio(lang);
const loc = lang === 'pt-BR' ? 'pt-BR' : 'en-US';
---

<AppLayout title={t('nav.overview')} current="home">
	<header class="ov-head">
		<div>
			<span class="eyebrow" style="text-align:left">{t('ov.eyebrow')}</span>
			<h1>{publication.name}</h1>
			<a class="site-link" href={site} target="_blank" rel="noopener">{new URL(site).host} ↗</a>
		</div>
		<div class="ov-actions">
			<a class="button" href="/admin">{t('nav.newPost')}</a>
			<a class="button ghost" href={site} target="_blank" rel="noopener">{t('nav.viewSite')}</a>
		</div>
	</header>

	{welcome && <div class="alert ok">{t('ov.welcome')}</div>}

	<section class="tiles">
		<a class="tile card" href="/admin/subscribers">
			<span class="n">{Number(subs?.n ?? 0).toLocaleString()}</span>
			<span class="l">{t('ov.subscribers')}</span>
			<span class="meter"><span style={`width:${pct(Number(subs?.n ?? 0), limits.subscribers)}`}></span></span>
			<span class="cap">{t('ov.of', { n: limits.subscribers.toLocaleString(loc) })}</span>
		</a>
		<a class="tile card" href="/admin">
			<span class="n">{Number(postCounts?.published ?? 0)}</span>
			<span class="l">{t('ov.published')}</span>
			<span class="cap">{t('ov.drafts', { n: Number(postCounts?.total ?? 0) - Number(postCounts?.published ?? 0) })}</span>
		</a>
		<a class="tile card" href="/billing">
			<span class="n">{sent.toLocaleString()}</span>
			<span class="l">{t('ov.emails')}</span>
			<span class="meter"><span style={`width:${pct(sent, limits.emailsPerMonth)}`}></span></span>
			<span class="cap">{t('ov.of', { n: limits.emailsPerMonth.toLocaleString(loc) })}{limits.probation ? t('ov.firstWeek') : ''}</span>
		</a>
	</section>

	<section class="recent card">
		<div class="recent-head">
			<h2>{t('ov.recent')}</h2>
			<a href="/admin" class="all">{t('ov.allPosts')}</a>
		</div>
		{recent.length === 0 ? (
			<p class="empty">{t('ov.empty')} <a href="/admin">{t('ov.emptyWrite')}</a> {t('ov.emptyOr')} <a href="/import">{t('ov.emptyImport')}</a>.</p>
		) : (
			<ul class="post-rows">
				{recent.map((p) => (
					<li>
						<a href={`/admin?post=${p.id}`} class="row-link">
							<span class="thumb">
								{p.coverUrl ? <img src={p.coverUrl} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <span class="initial">{(p.title.trim()[0] ?? '✦').toUpperCase()}</span>}
							</span>
							<span class="meta">
								<span class="t">{p.title || t('ov.untitled')}</span>
								<span class="x">{p.excerpt}</span>
							</span>
							<span class="status">
								<span class="badge">{t(p.sentAt ? 'status.sent' : p.isPublished ? 'status.published' : 'status.draft')}</span>
								<span class="d">{fmt(p.publishedAt)}{p.lang === 'pt' ? ' · PT' : ' · EN'}</span>
							</span>
						</a>
					</li>
				))}
			</ul>
		)}
	</section>

	<style>
		.ov-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 2rem; }
		.ov-head h1 { margin: 0.2rem 0 0.3rem; }
		.site-link { font-size: 0.92rem; font-style: italic; color: var(--muted); text-decoration: none; }
		.site-link:hover { color: var(--accent); }
		.ov-actions { display: flex; gap: 0.6rem; }
		.button.ghost { background: transparent; color: var(--ink); }
		.button.ghost:hover { background: var(--ink); color: var(--card); border-color: var(--ink); }
		.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
		.tile { display: flex; flex-direction: column; gap: 0.25rem; padding: 1.2rem 1.35rem; color: var(--text); text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
		.tile:hover { transform: translateY(-2px); box-shadow: var(--shadow-lift); }
		.tile .n { font-family: var(--font-display-stack); font-weight: 500; font-size: 2.4rem; line-height: 1.05; color: var(--ink); }
		.tile .l { font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
		.tile .cap { font-size: 0.8rem; font-style: italic; color: var(--muted); }
		.tile .meter { display: block; height: 4px; margin-top: 0.4rem; background: rgba(var(--gray-light), 0.7); }
		.tile .meter > span { display: block; height: 100%; background: var(--accent); }
		.recent { padding: 1.5rem 1.6rem 1rem; }
		.recent-head { display: flex; justify-content: space-between; align-items: baseline; }
		.recent-head h2 { margin: 0 0 0.75rem; border: 0; padding: 0; }
		.all { font-size: 0.9rem; text-decoration: none; }
		.empty { text-align: left; }
		.post-rows { list-style: none; margin: 0; padding: 0; }
		.post-rows li + li { border-top: var(--hairline); }
		.row-link { display: grid; grid-template-columns: 96px 1fr auto; gap: 1rem; align-items: center; padding: 0.8rem 0.25rem; color: var(--text); text-decoration: none; }
		.row-link:hover .t { color: var(--accent); }
		.thumb { width: 96px; aspect-ratio: 16 / 10; overflow: hidden; background: color-mix(in srgb, var(--accent) 12%, var(--card)); display: grid; place-items: center; }
		.thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
		.initial { font-family: var(--font-display-stack); font-style: italic; font-size: 1.6rem; color: color-mix(in srgb, var(--accent) 70%, var(--card)); }
		.meta { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
		.t { font-family: var(--font-display-stack); font-weight: 500; font-size: 1.15rem; line-height: 1.2; color: var(--ink); transition: color 0.2s; }
		.x { font-size: 0.85rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
		.status { display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem; white-space: nowrap; }
		.d { font-size: 0.8rem; color: var(--muted); }
		@media (max-width: 640px) {
			.row-link { grid-template-columns: 72px 1fr; }
			.thumb { width: 72px; }
			.status { display: none; }
		}
	</style>
</AppLayout>
