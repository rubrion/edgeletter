---
import AdminHead from '../../components/AdminHead.astro';
import LogoMark from '../../components/LogoMark.astro';
import { loadSettings } from '../../lib/settings';

const error = Astro.url.searchParams.get('error');
const settings = await loadSettings(Astro.locals.publication.id);
const themeColor = settings.themePrimaryColor;
const clientName = settings.clientName;
---
<!doctype html>
<html lang="en">
<head>
  <AdminHead title={`Admin login — ${clientName}`} />
  <style is:global>
    body { display: grid; place-items: center; padding: 2rem 1rem; box-sizing: border-box; }
    .envelope {
      position: relative;
      width: min(420px, 100%);
      padding: 5.75rem 1.5rem 1.5rem;
    }
    .envelope.pocket { position: relative; }
    .envelope-mark {
      position: absolute;
      top: 2.4rem;
      left: 0;
      right: 0;
      text-align: center;
      font-family: var(--font-eyebrow-stack);
      font-style: italic;
      font-weight: 500;
      font-size: 1.7rem;
      line-height: 1;
      pointer-events: none;
    }
    .login {
      position: relative;
      z-index: 1;
      padding: 2.25rem 2rem 2rem;
      text-align: center;
    }
    .login-mark { display: block; margin: 0 auto 1rem; box-shadow: var(--shadow-paper); }
    .login h1 { font-size: 2.2rem; margin-bottom: 0.25rem; }
    .login .micro { color: var(--muted); margin: 0 0 1.75rem; }
    .login label { text-align: left; }
    .login button[type="submit"] { width: 100%; margin-top: 1.25rem; }
    .err { color: #9C2F14; margin: 1rem 0 0; font-size: 0.9rem; font-style: italic; }
  </style>
</head>
<body style={`--theme: ${themeColor}`}>
  <div class="envelope pocket">
    <span class="envelope-mark deboss" aria-hidden="true">Private correspondence</span>
    <form class="login card lift" method="POST" action="/api/admin/login">
      <LogoMark size={44} class="login-mark" />
      <h1>{clientName}</h1>
      <p class="micro bracket">Editor's desk</p>
      <label for="key">Master admin key</label>
      <input id="key" name="key" type="password" autocomplete="current-password" required />
      <button type="submit">Sign in</button>
      {error && <p class="err">Wrong key. Try again.</p>}
    </form>
  </div>
</body>
</html>
