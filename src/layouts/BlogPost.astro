---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getLang, useTranslations, type Lang } from '../i18n';

interface Props {
	title: string;
	description: string;
	pubDate?: Date | null;
	lang?: Lang;
	canonical?: string;
	/** Script eyebrow above the title; defaults to the post eyebrow. */
	eyebrow?: string;
}

const { title, description, pubDate, lang: langProp, canonical } = Astro.props;
const lang = langProp ?? getLang(Astro.request);
const t = useTranslations(lang);
const eyebrow = Astro.props.eyebrow ?? t('post.eyebrow');
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			ogType="article"
			publishedAt={pubDate ?? null}
			canonical={canonical}
		/>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="title">
					<span class="eyebrow rise" style="--i: 0">{eyebrow}</span>
					<h1 class="rise" style="--i: 1">{title}</h1>
					{pubDate ? (
						<div class="micro bracket date rise" style="--i: 2">
							<FormattedDate date={pubDate} lang={lang} />
						</div>
					) : (
						<div class="ornament rise" style="--i: 2" aria-hidden="true">✦</div>
					)}
				</header>
				<div class="sheet card rise" style="--i: 3">
					<div class="prose">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 860px;
	}
	.title {
		text-align: center;
		margin: 0 auto 3rem;
		max-width: 760px;
	}
	.title h1 {
		font-size: clamp(2.6rem, 7vw, 4.6rem);
		margin: 0 0 1.25rem;
	}
	.date {
		color: var(--muted);
	}
	.sheet {
		padding: 4rem 4.5rem 3.5rem;
	}
	.prose {
		max-width: 640px;
		margin: 0 auto;
		color: var(--text);
	}
	/* Editorial drop cap on the opening paragraph */
	.prose > :global(p:first-of-type)::first-letter,
	.prose > :global(div > p:first-of-type)::first-letter {
		float: left;
		font-family: var(--font-display-stack);
		font-weight: var(--display-weight);
		word-spacing: var(--display-words);
		font-size: 4.4em;
		line-height: 0.82;
		padding: 0.06em 0.12em 0 0;
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.sheet { padding: 2.25rem 1.4rem 2rem; }
		.title { margin-bottom: 2rem; }
	}
</style>
