---
// EdgeLetter mark: a letter rising out of an envelope. 64-unit grid,
// uniform 4-unit stroke, miter joins — drawn to read as a flat pictogram.
// Tile follows the tenant accent; strokes stay ivory for contrast.
interface Props {
	size?: number | string;
	class?: string;
	/** "tile" = accent square with ivory strokes; "ink" = strokes only in currentColor. */
	variant?: 'tile' | 'ink';
	title?: string;
}

const { size = 32, class: className, variant = 'tile', title, ...rest } = Astro.props;
const stroke = variant === 'tile' ? '#F5F3EE' : 'currentColor';
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 64 64"
	xmlns="http://www.w3.org/2000/svg"
	role={title ? 'img' : undefined}
	aria-label={title}
	aria-hidden={title ? undefined : 'true'}
	{...rest}
>
	{variant === 'tile' && <rect width="64" height="64" style="fill: var(--accent, #B44A27)" />}
	<g fill="none" stroke={stroke} stroke-width="4" stroke-linejoin="miter" stroke-linecap="butt">
		<path d="M20 34V12H44V34" />
		<path d="M26 20H38" />
		<path d="M12 28L32 42L52 28V52H12Z" />
	</g>
</svg>
