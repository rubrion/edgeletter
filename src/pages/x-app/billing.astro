---
import AppLayout from '../../layouts/AppLayout.astro';
import { emailsThisMonth, formatBytes, limitsFor, mediaBytesUsed, PLAN_LIMITS, PRO_PRICE, subscriberCount } from '../../lib/plans';
import { embeddedEnabled, publishableKey, retrieveCheckout, stripeEnabled, yearlyEnabled } from '../../lib/stripe';
import { applySubscription } from '../../lib/billing';
import { eq } from 'drizzle-orm';
import { getDbInstance, publications } from '../../db';
import { getLang } from '../../i18n';
import { studio } from '../../i18n/studio';


const { publication } = Astro.locals as Required<App.Locals>;

// Back from embedded Checkout: confirm with Stripe and apply the plan now,
// instead of waiting for the webhook (which still arrives and is idempotent).
const sessionId = Astro.url.searchParams.get('session_id');
if (sessionId && stripeEnabled()) {
	const session = await retrieveCheckout(sessionId).catch(() => null);
	if (session && session.client_reference_id === publication.id) {
		if (session.status === 'complete' && session.subscription) {
			await applySubscription(session.subscription, publication.id).catch((err) => console.error('checkout return', err));
			return Astro.redirect('/billing?upgraded=1', 303);
		}
		if (session.status === 'open') return Astro.redirect('/billing?checkout=incomplete', 303);
	}
	return Astro.redirect('/billing', 303);
}
const limits = limitsFor(publication);
const [emails, subs, media] = await Promise.all([
	emailsThisMonth(publication.id),
	subscriberCount(publication.id),
	mediaBytesUsed(publication.id),
]);
const lang = getLang(Astro.request);
const t = studio(lang);
const loc = lang === 'pt-BR' ? 'pt-BR' : 'en-US';
const pct = (a: number, b: number) => `${Math.min(100, Math.round((a / Math.max(1, b)) * 100))}%`;
const error = Astro.url.searchParams.get('error') ? t('bill.notConfigured') : null;
const upgraded = Astro.url.searchParams.get('upgraded') === '1';
const incomplete = Astro.url.searchParams.get('checkout') === 'incomplete';
const embedded = embeddedEnabled();
const pro = publication.plan === 'pro';
// Pro without a Stripe subscription was granted by staff (house and reviewer
// accounts): nothing to bill, so no portal. A past customer still gets the
// portal for invoices.
const [billingRow] = await getDbInstance()
	.select({ customerId: publications.stripeCustomerId, subscriptionId: publications.stripeSubscriptionId })
	.from(publications)
	.where(eq(publications.id, publication.id))
	.limit(1);
const complimentary = pro && !billingRow?.subscriptionId;
const canManage = stripeEnabled() && !!billingRow?.customerId;
---

<AppLayout title={t('nav.plan')} current="billing">
	<div class="card app-card">
		<header class="page-head">
			<span class="eyebrow">{t('bill.eyebrow')}</span>
			<h1>{pro ? t('bill.pro') : t('bill.free')}</h1>
			<p class="sub">{limits.probation ? t('bill.probation') : complimentary ? t('bill.compLead') : pro ? t('bill.thanks') : t('bill.upgradeLead')}</p>
		</header>
		{upgraded && (pro ? <div class="alert ok">{t('bill.welcomePro')}</div> : <div class="alert ok">{t('bill.paid')}</div>)}
		{incomplete && <div class="alert err">{t('bill.incomplete')}</div>}
		{error && <div class="alert err">{error}</div>}

		<h2>{t('bill.month')}</h2>
		<div class="stack">
			<div><div class="row" style="justify-content:space-between"><span>{t('bill.emailsSent')}</span><span>{emails.toLocaleString(loc)} / {limits.emailsPerMonth.toLocaleString(loc)}</span></div><div class="meter"><span style={`width:${pct(emails, limits.emailsPerMonth)}`}></span></div></div>
			<div><div class="row" style="justify-content:space-between"><span>{t('bill.subscribers')}</span><span>{subs.toLocaleString(loc)} / {limits.subscribers.toLocaleString(loc)}</span></div><div class="meter"><span style={`width:${pct(subs, limits.subscribers)}`}></span></div></div>
			<div><div class="row" style="justify-content:space-between"><span>{t('bill.media')}</span><span>{formatBytes(media)} / {formatBytes(limits.mediaBytes)}</span></div><div class="meter"><span style={`width:${pct(media, limits.mediaBytes)}`}></span></div></div>
		</div>

		<h2>{pro ? t('bill.manage') : t('bill.includes')}</h2>
		{pro ? (
			<>
				{complimentary && <p class="muted comp-note">{t('bill.compNote')}</p>}
				{canManage && <form method="post" action="/api/billing/portal"><button type="submit">{complimentary ? t('bill.invoices') : t('bill.manageBilling')}</button></form>}
			</>
		) : (
			<>
				<dl class="kv">
					<dt>{t('bill.kvSubscribers')}</dt><dd>{PLAN_LIMITS.pro.subscribers.toLocaleString(loc)}</dd>
					<dt>{t('bill.kvEmails')}</dt><dd>{t('bill.kvEmailsVal', { n: PLAN_LIMITS.pro.emailsPerMonth.toLocaleString(loc) })}</dd>
					<dt>{t('bill.kvMedia')}</dt><dd>{formatBytes(PLAN_LIMITS.pro.mediaBytes)}</dd>
					<dt>{t('bill.kvDomain')}</dt><dd>{t('bill.kvDomainVal')}</dd>
					<dt>{t('bill.kvBranding')}</dt><dd>{t('bill.kvBrandingVal')}</dd>
				</dl>
				<p style="margin:1.5rem 0 0.25rem"><strong>{t('bill.price', { brl: PRO_PRICE.monthly.brl })}</strong> <span class="muted">{t('bill.priceNote', { usd: PRO_PRICE.monthly.usd })}</span></p>
				<div class="row" style="margin-top:1rem">
					<form method="post" action="/api/billing/checkout" class="inline-form" data-checkout="month">
						<input type="hidden" name="interval" value="month" />
						<button type="submit" disabled={!stripeEnabled()}>{stripeEnabled() ? t('bill.monthly') : t('bill.soon')}</button>
					</form>
					{yearlyEnabled() && (
						<form method="post" action="/api/billing/checkout" class="inline-form" data-checkout="year">
							<input type="hidden" name="interval" value="year" />
							<button type="submit">{t('bill.yearly', { brl: PRO_PRICE.yearly.brl, usd: PRO_PRICE.yearly.usd })}</button>
						</form>
					)}
				</div>
			</>
		)}
	</div>

	{embedded && !pro && (
		<>
			<dialog class="checkout-modal" id="checkout-modal" aria-labelledby="checkout-title">
				<div class="checkout-head">
					<span class="eyebrow" id="checkout-title">{t('bill.secure')}</span>
					<button type="button" class="close-btn" id="checkout-close" aria-label={t('bill.cancel')}>×</button>
				</div>
				<p class="checkout-status muted" id="checkout-status">{t('bill.loading')}</p>
				<div id="checkout"></div>
			</dialog>
			<script is:inline src="https://js.stripe.com/v3/" async></script>
			<script
				is:inline
				define:vars={{ pk: publishableKey(), errMsg: t('bill.checkoutError'), loading: t('bill.loading'), locale: lang === 'pt-BR' ? 'pt-BR' : 'en' }}
			>
				const modal = document.getElementById('checkout-modal');
				const status = document.getElementById('checkout-status');
				const forms = document.querySelectorAll('form[data-checkout]');
				let instance = null;

				const waitForStripe = () =>
					new Promise((resolve, reject) => {
						let n = 0;
						const tick = () => (window.Stripe ? resolve(window.Stripe) : ++n > 100 ? reject(new Error('stripe.js')) : setTimeout(tick, 50));
						tick();
					});

				// Every way out (×, Esc, backdrop click) ends in the dialog's close event.
				modal.addEventListener('close', () => {
					if (instance) { instance.destroy(); instance = null; }
					document.documentElement.classList.remove('modal-open');
					forms.forEach((f) => (f.querySelector('button').disabled = false));
				});
				document.getElementById('checkout-close').addEventListener('click', () => modal.close());
				modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });

				forms.forEach((form) =>
					form.addEventListener('submit', async (e) => {
						e.preventDefault();
						if (modal.open) modal.close();
						forms.forEach((f) => (f.querySelector('button').disabled = true));
						status.hidden = false;
						status.textContent = loading;
						document.documentElement.classList.add('modal-open');
						modal.showModal();
						try {
							const Stripe = await waitForStripe();
							const stripe = Stripe(pk, { locale });
							const fetchClientSecret = async () => {
								const res = await fetch('/api/billing/checkout', {
									method: 'POST',
									headers: { 'Content-Type': 'application/json' },
									credentials: 'same-origin',
									body: JSON.stringify({ interval: form.dataset.checkout }),
								});
								const j = await res.json().catch(() => ({}));
								if (!res.ok || !j.clientSecret) throw new Error(j.error || String(res.status));
								return j.clientSecret;
							};
							const create = (stripe.createEmbeddedCheckoutPage || stripe.initEmbeddedCheckout).bind(stripe);
							instance = await create({ fetchClientSecret });
							status.hidden = true;
							instance.mount('#checkout');
						} catch (err) {
							console.error(err);
							status.textContent = errMsg;
						}
					}),
				);
			</script>
		</>
	)}

	<style>
		.comp-note { font-style: italic; margin: 0 0 1rem; }
		:global(html.modal-open) { overflow: hidden; }
		.checkout-modal {
			width: min(560px, calc(100vw - 2rem));
			max-height: calc(100dvh - 2rem);
			padding: 1.25rem 1.25rem 1.5rem;
			border: var(--hairline);
			border-radius: 4px;
			background: var(--card);
			color: var(--text);
			box-shadow: var(--shadow-lift);
			overflow-y: auto;
		}
		.checkout-modal[open] { animation: modal-in 0.28s var(--ease-paper, ease) both; }
		.checkout-modal::backdrop { background: rgba(28, 22, 18, 0.45); backdrop-filter: blur(2px); animation: fade-in 0.2s ease both; }
		@keyframes modal-in { from { opacity: 0; transform: translateY(12px) scale(0.985); } to { opacity: 1; transform: none; } }
		@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
		@media (prefers-reduced-motion: reduce) { .checkout-modal[open], .checkout-modal::backdrop { animation: none; } }
		.checkout-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
		.checkout-head .eyebrow { text-align: left; margin: 0; }
		.close-btn { width: 2.25rem; height: 2.25rem; padding: 0; background: none; border: 0; box-shadow: none; color: var(--muted); font-size: 1.6rem; line-height: 1; cursor: pointer; letter-spacing: 0; }
		.close-btn:hover { color: var(--accent); background: none; }
		.checkout-status { font-style: italic; text-align: center; padding: 2rem 0; }
		#checkout { min-height: 2rem; border-radius: 6px; overflow: hidden; }
	</style>
</AppLayout>
