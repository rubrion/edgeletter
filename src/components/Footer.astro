---
import { getLang, useTranslations } from '../i18n';
import { loadSettings } from '../lib/settings';
import SubscribeForm from './SubscribeForm.astro';

const settings = await loadSettings();
const clientName = settings.clientName;
const today = new Date();

const lang = getLang(Astro.request);
const t = useTranslations(lang);
---

<section class="envelope pocket" aria-label={t('subscribe.heading')}>
	<span class="envelope-mark deboss" aria-hidden="true">{clientName}</span>
	<div class="envelope-slot lift">
		<SubscribeForm lang={lang} />
	</div>
	<footer class="deboss">
		<span class="micro">&copy; {today.getFullYear()} {clientName}</span>
		<span class="sep" aria-hidden="true">✦</span>
		<span class="micro">{t('footer.rights')}</span>
	</footer>
</section>

<style>
	.envelope {
		margin-top: 4rem;
		padding: clamp(7.5rem, 15vw, 11rem) 1.25rem 0;
		overflow: hidden;
	}
	/* Large tone-on-tone debossed mark behind the letter */
	.envelope-mark {
		position: absolute;
		top: 2.75rem;
		left: 50%;
		transform: translateX(-50%);
		width: 100%;
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		font-family: var(--font-display-stack);
		font-size: clamp(3.25rem, 10vw, 7.5rem);
		line-height: 1;
		letter-spacing: -0.03em;
		pointer-events: none;
		user-select: none;
	}
	.envelope-slot {
		position: relative;
		z-index: 1;
		max-width: 560px;
		margin: 0 auto;
	}
	footer {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.4rem 0.9rem;
		padding: 3.5rem 1rem 3rem;
		text-align: center;
	}
	.sep { font-size: 0.7rem; }
</style>
