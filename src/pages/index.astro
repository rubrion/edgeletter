---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getLang, useTranslations } from '../i18n';
import { loadSettings } from '../lib/settings';
import PostCard from '../components/PostCard.astro';
import { listPosts } from '../lib/post-lists';

const lang = getLang(Astro.request);
const t = useTranslations(lang);

const settings = await loadSettings(Astro.locals.publication.id);
const clientName = settings.clientName;
const description = `Latest from ${clientName}.`;
const tagline = settings.clientTagline || 'Notes, essays, and announcements — straight to your inbox.';

const recent = await listPosts(Astro.locals.publication.id, lang, 5);

const [featured, ...rest] = recent;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={clientName} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<span class="eyebrow rise" style="--i: 0">{t('index.eyebrow')}</span>
				<h1 class="rise" style="--i: 1">{clientName}</h1>
				<div class="ornament rise" style="--i: 2" aria-hidden="true">✦</div>
				<p class="tagline rise" style="--i: 3">{tagline}</p>
			</section>
		</main>
		{featured && (
			<section class="latest pocket" aria-labelledby="latest-heading">
				<span class="pocket-label deboss reveal" aria-hidden="true">{t('index.latestLabel')}</span>
				<h2 id="latest-heading" class="sr-only">{t('index.latestPosts')}</h2>
				<div class="stack">
					<div class="featured-wrap">
						<PostCard post={featured} lang={lang} variant="feature" badge={t('index.featured')} i={1} />
					</div>
					{rest.length > 0 && (
						<ul class="post-grid">
							{rest.map((p, i) => (
								<li><PostCard post={p} lang={lang} i={(i % 2) + 1} /></li>
							))}
						</ul>
					)}
					<p class="all reveal"><a href="/blog" class="btn">{t('index.allPosts')}</a></p>
				</div>
			</section>
		)}
		<Footer />
	</body>
</html>

<style>
	.hero {
		text-align: center;
		padding: 3.5em 0 1.5em;
	}
	.hero h1 {
		font-size: clamp(3.2rem, 9vw, 6.5rem);
		margin: 0;
	}
	.tagline {
		max-width: 34em;
		margin: 0 auto;
		font-style: italic;
		font-size: 1.15em;
		color: var(--muted);
	}

	.latest {
		/* The debossed label sits at top: 3rem; cards start just below its
		   baseline so the letters are never covered, at any width. */
		--label-size: clamp(4rem, 14vw, 11rem);
		padding: 6rem 1.25rem 3.5rem;
	}
	.pocket-label {
		position: absolute;
		top: 3rem;
		left: 0;
		right: 0;
		text-align: center;
		font-family: var(--font-display-stack);
		font-weight: var(--display-weight);
		word-spacing: var(--display-words);
		font-style: italic;
		font-size: var(--label-size);
		line-height: 1;
		letter-spacing: var(--display-tracking);
		pointer-events: none;
		user-select: none;
	}
	.stack {
		position: relative;
		z-index: 1;
		max-width: 880px;
		margin: 0 auto;
	}
	.featured-wrap { margin-top: calc(var(--label-size) - 0.75rem); }
	.post-grid {
		list-style: none;
		padding: 0;
		margin: 1.25rem 0 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}
	/* Odd count: last card spans the full row instead of sitting alone */
	.post-grid li { display: flex; }
	.post-grid li > :global(a) { flex: 1; }
	.post-grid li:last-child:nth-child(odd) { grid-column: 1 / -1; }
	.all {
		text-align: center;
		margin: 2.5rem 0 0;
	}
	.all .btn {
		background: var(--card);
		color: var(--ink);
		border-color: var(--card);
	}
	.all .btn:hover { background: var(--ink); color: var(--card); border-color: var(--ink); }

	@media (max-width: 640px) {
		.post-grid { grid-template-columns: 1fr; }
		.latest { padding: 5rem 1rem 2.5rem; }
		.featured-wrap { margin-top: calc(var(--label-size) - 0.5rem); }
	}
</style>
